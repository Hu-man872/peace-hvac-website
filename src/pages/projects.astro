---
import BaseLayout from "../components/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import QuoteBand from "../components/QuoteBand.astro";
import { projectGallery, sectors } from "../data/company";
---

<BaseLayout
  title="Project Experience"
  active="projects"
  description="PEACE HVAC Engineers' documented experience across commercial, institutional, industrial and residential environments."
>
  <PageHero
    title="Experience across demanding buildings."
    intro="PEACE's supplied company profile documents HVAC work for commercial offices, hospitality, hospitals, institutions, industrial facilities, data centres, malls and residential projects."
    image="/assets/field/ductwork-site.jpg"
    imageAlt="Ductwork installation in progress at a commercial building site"
  />

  <section class="section sector-section shell">
    <h2>Where our experience applies</h2>
    <div class="sector-index">
      {sectors.map((sector) => <div><span>{sector}</span></div>)}
    </div>
  </section>

  <section class="section project-proof shell">
    <div class="project-proof-copy">
      <h2>Project and client record</h2>
      <p class="lead">
        The supplied profile presents a detailed reference sheet of client installations across
        commercial, hospitality, healthcare, institutional and industrial sectors.
      </p>
      <p>
        Before public launch, individual project details and client permissions should be confirmed
        so each reference can become a focused case study with scope, system type and location.
      </p>
    </div>
    <figure class="document-frame">
      <img
        src="/assets/client-experience.jpg"
        alt="Client and project experience sheet from the PEACE HVAC company profile"
        width="854"
        height="1068"
        loading="lazy"
      />
      <figcaption>Client and installation reference sheet supplied in the company profile.</figcaption>
    </figure>
  </section>

  <section class="section project-gallery">
    <div class="shell section-heading-row">
      <h2>Capabilities in practice</h2>
      <p>Cooling equipment, air distribution, refrigerant piping and maintenance.</p>
    </div>
    <div class="gallery-grid shell field-gallery project-field-gallery">
      {
        projectGallery.map((project) => (
          <figure>
            <img src={project.image} alt={project.alt} width="720" height="520" loading="lazy" />
            <figcaption>{project.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <QuoteBand />
</BaseLayout>
