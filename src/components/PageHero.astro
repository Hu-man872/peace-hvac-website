---
interface Props {
  title: string;
  intro: string;
  image: string;
  imageAlt: string;
}

const { title, intro, image, imageAlt } = Astro.props;
---

<section class="page-hero shell">
  <div class="page-hero-copy">
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
  <figure class="page-hero-media">
    <img src={image} alt={imageAlt} width="953" height="806" />
  </figure>
</section>
